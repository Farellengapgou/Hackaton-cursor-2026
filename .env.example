# Copier vers .env à la RACINE du projet (FINAUDIT/.env)
# Utilisé par : docker compose ET backend en local (./backend/run.sh)
# backend/.env reste optionnel pour surcharger — ne jamais committer .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
# Local : http://localhost:8080  |  Public : https://votre-domaine.com
FINAUDIT_CORS_ORIGIN=http://localhost:8081
