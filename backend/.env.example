# Optionnel — enrichit /explain et /chat via Gemini (fallback template si absent ou erreur)
# Clé gratuite : https://aistudio.google.com/apikey
# Optionnel : surcharge locale. Sinon, mettez la clé dans ../.env (racine FINAUDIT)
GEMINI_API_KEY=
# Modèle Gemini (défaut: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Timeout appel Gemini en secondes (défaut: 12)
# GEMINI_TIMEOUT_SECONDS=12
# Optionnel — explications via Anthropic (route /api/chat legacy)
# ANTHROPIC_API_KEY=
